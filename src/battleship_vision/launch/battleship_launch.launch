<launch>
  <!-- Nodo de cámara de la mano -->
  <node pkg="battleship_vision"
        type="hand_camera_node.py"
        name="hand_camera_node"
        output="screen">
    <!-- Si quisieras cambiar el frame o topic, podrías añadir más params aquí -->
  </node>

  <!-- Nodo de la mano (gestos) -->
  <node pkg="battleship_vision"
        type="hand_node.py"
        name="hand_node"
        output="screen">
    <!-- El topic de imagen se puede sobreescribir, por defecto es hand_camera/image_raw -->
    <param name="image_topic" value="hand_camera/image_raw" />
  </node>

  <!-- Nodo de cámara del tablero -->
  <node pkg="battleship_vision"
        type="board_camera_node.py"
        name="board_camera_node"
        output="screen">
  </node>

  <!-- Nodo del tablero (detección barcos, munición, etc.) -->
  <node pkg="battleship_vision"
        type="board_node.py"
        name="board_node"
        output="screen">
    <!-- El topic de imagen se puede sobreescribir, por defecto es board_camera/image_raw -->
    <param name="image_topic" value="board_camera/image_raw" />
  </node>

  <!-- Nodo de lógica del juego (recibe layouts y ataques, responde resultado) -->
  <node pkg="battleship_vision"
        type="game_logic_node.py"
        name="game_logic_node"
        output="screen" />
</launch>
