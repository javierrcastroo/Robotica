<launch>
  <!-- Nodo de cámara de la mano -->
  <node pkg="battleship_vision"
        type="hand_camera_node.py"
        name="hand_camera_node"
        output="screen" />

  <!-- Nodo de la mano (gestos) -->
  <node pkg="battleship_vision"
        type="hand_node.py"
        name="hand_node"
        output="screen">
    <param name="image_topic" value="hand_camera/image_raw" />
  </node>
</launch>
